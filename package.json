{
  "name": "asset-catalogue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run --coverage",
    "knip": "knip --no-progress",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "npm run check && npm run lint && npm run knip && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "knip": "^5.45.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}

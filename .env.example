# Every setting the asset catalogue needs (docs/PRD.md section 9). None has a
# built-in value; the app refuses to start and names any that are missing.
# On the Mac, secrets go only in ~/.config/dave-hq/local.env (mode 600);
# copy this file to .env (git ignores it) for the rest. Never commit values.

# The database (PostgreSQL with pgvector 0.8 or newer).
DATABASE_URL=
# The models repository on GitHub, as owner/name.
ASSETS_REPO=

# The GitHub App (keys and sign-in). Secrets: local.env only.
ASSET_CATALOGUE_GITHUB_APP_ID=
ASSET_CATALOGUE_GITHUB_APP_INSTALLATION_ID=
ASSET_CATALOGUE_GITHUB_APP_CLIENT_ID=
ASSET_CATALOGUE_GITHUB_APP_CLIENT_SECRET=
ASSET_CATALOGUE_GITHUB_APP_KEY_FILE=
# GitHub accounts allowed to sign in, separated by commas.
ALLOWED_GITHUB_USERS=
# At least 32 random characters, for signing people in. Secret: local.env only.
SESSION_SECRET=

# Search: a score at or above MATCH_THRESHOLD is a match; between
# NEAR_THRESHOLD and MATCH_THRESHOLD is a close match. Both between 0 and 1.
MATCH_THRESHOLD=
NEAR_THRESHOLD=

# Fetching models.
MAX_GLB_MB=
REQUEST_DEADLINE_MIN=
MONTHLY_CAP_USD=
# Paid generators switched on. Must stay empty until Giggles chooses one.
GENERATORS_ON=
